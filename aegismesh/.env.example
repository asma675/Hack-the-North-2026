# Core server
PORT=3000
AUTH_SECRET=replace-with-a-long-random-secret
EDGE_SHARED_SECRET=replace-with-the-same-secret-on-the-enforcement-pi

# OpenAI Evidence Court
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=1400

# Huawei openJiuwen / JiuwenSwarm A2A gateway
# Example: http://127.0.0.1:19100/a2a
JIUWEN_A2A_URL=
JIUWEN_A2A_TOKEN=
JIUWEN_TIMEOUT_MS=20000

# Optional Cloudflare Aegis Gate Worker
CLOUDFLARE_GATE_URL=
CLOUDFLARE_GATE_TOKEN=

# Optional physical Aegis Edge service
# Example: http://192.168.1.50:8090
EDGE_DEVICE_URL=
EDGE_DEVICE_TOKEN=

# Optional Huawei OMNI adapter endpoint
OMNI_API_URL=
OMNI_API_KEY=

# Optional observability
SENTRY_DSN=

# Vercel persistence: optional Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AEGIS_REDIS_KEY=aegismesh:state

# Frontend: blank means same origin. Set only when frontend and API are split.
VITE_API_URL=

# Set these on the enforcement Pi, not the browser.
# EDGE_ALLOW_RELAY_TEST=false
# EDGE_RELAY_PIN=17
# EDGE_LED_PIN=27
# EDGE_BUZZER_PIN=22
